## 📝 Code Standards

### Terraform Standards

#### 1. File Organization

```hcl
# modules/<module-name>/
# ├── main.tf          # Primary resources
# ├── variables.tf     # Input variables
# ├── outputs.tf       # Output values
# ├── versions.tf      # Provider versions
# ├── data.tf          # Data sources (optional)
# ├── locals.tf        # Local values (optional)
# └── README.md        # Documentation
```

#### 2. Naming Conventions

```hcl
# Resources: lowercase with underscores
resource "aws_security_group" "eks_cluster" {
  name = "${var.cluster_name}-cluster-sg"
}

# Variables: lowercase with underscores
variable "cluster_name" {
  type = string
}

# Locals: lowercase with underscores
locals {
  common_tags = {
    ManagedBy   = "Terraform"
    Environment = var.environment
  }
}
```

#### 3. Required Elements

**All modules must include**:

```hcl
# versions.tf
terraform {
  required_version = ">= 1.6.0"
  
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

# variables.tf - Always include validation
variable "cluster_name" {
  description = "Name of the EKS cluster"
  type        = string
  
  validation {
    condition     = can(regex("^[a-z0-9-]+$", var.cluster_name))
    error_message = "Cluster name must contain only lowercase letters, numbers, and hyphens."
  }
}

# main.tf - Always tag resources
resource "aws_eks_cluster" "main" {
  name = var.cluster_name
  
  tags = merge(
    var.common_tags,
    {
      "Name"        = var.cluster_name
      "ManagedBy"   = "Terraform"
      "CostCenter"  = var.cost_center
      "Environment" = var.environment
    }
  )
}

# outputs.tf - Always include descriptions
output "cluster_endpoint" {
  description = "Endpoint for EKS control plane"
  value       = aws_eks_cluster.main.endpoint
}
```

#### 4. Sensitive Data Handling

```hcl
# ✅ Good: Use AWS Secrets Manager
data "aws_secretsmanager_secret_version" "db_password" {
  secret_id = "prod/database/password"
}

# ❌ Bad: Hardcoded secrets
variable "database_password" {
  default = "SuperSecret123!"  # NEVER DO THIS
}

# Mark outputs as sensitive
output "database_password" {
  value     = data.aws_secretsmanager_secret_version.db_password.secret_string
  sensitive = true
}
```

#### 5. Cost Tagging (Mandatory)

```hcl
# ALL resources must have these tags
locals {
  required_tags = {
    "CostCenter"         = var.cost_center          # Required: CC-XXXX format
    "Environment"        = var.environment          # Required: prod/staging/nonprod
    "ManagedBy"          = "Terraform"              # Required
    "DataClassification" = var.data_classification  # Required: Public/Internal/Confidential/Restricted
    "BackupPolicy"       = var.backup_policy        # Required: daily/weekly/none
  }
}
```

